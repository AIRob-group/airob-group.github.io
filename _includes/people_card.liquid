<div class="col-sm-auto text-center mb-3">
  <a href="{% if profile.intro %}#{{ profile.firstname }}_{{ profile.lastname }}{% endif %}">
    <div class="card h-100 hoverable">
      {% if profile.image %}
        {% assign profile_image_path = profile.image | prepend: 'assets/img/profiles/' %}
      {% else %}
        {% assign profile_image_path = 'assets/img/profiles/robot.png' %}
      {% endif %}
      {%
        include figure.liquid
        loading="eager"
        path=profile_image_path
        sizes="150px"
        width="75%"
        alt="profile thumbnail"
        class="card-img-top"
      %}
      <span class="card-title">
        {{ profile.firstname }}
        {{ profile.lastname }}
        {% case profile.type %}
          {% when 'F_PHD' -%}
            (Ph.D.)
          {% when 'F_MSC' -%}
            (M.Sc.)
          {% when 'F_UNDERGRAD' -%}
            (Undergrad)
          {% when 'F_VISITOR' -%}
            (Visitor)
        {% endcase -%}
      </span>
      <div class="row ml-1 mr-1 p-0 justify-content-center">
        {% include profile_social.liquid %}
      </div>
    </div>
  </a>
</div>
