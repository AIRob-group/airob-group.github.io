{% if profile.webpage %}
  <div class="webpage-icon">
    <div class="icon mx-1" data-toggle="tooltip" title="Personal Webpage">
      <a href="{{ profile.webpage }}"><i class="fa-solid fa-globe fa-lg"></i></a>
    </div>
  </div>
{% endif %}
{% if profile.github %}
  <div class="github-icon">
    <div class="icon mx-1" data-toggle="tooltip" title="Github Profile">
      <a href="{{ profile.github }}"><i class="fa-brands fa-github gh-icon fa-lg"></i></a>
    </div>
  </div>
{% endif %}
{% if profile.google_scholar %}
  <div class="google-scholar-icon">
    <div class="icon mx-1" data-toggle="tooltip" title="Google Scholar">
      <a href="{{ profile.google_scholar }}"><i class="fa-solid fa-graduation-cap fa-lg"></i></a>
    </div>
  </div>
{% endif %}
{% if profile.linkedin %}
  <div class="linkedin-icon">
    <div class="icon mx-1" data-toggle="tooltip" title="LinkedIn Profile">
      <a href="{{ profile.linkedin }}"><i class="fa-brands fa-linkedin-in in-icon fa-lg"></i></a>
    </div>
  </div>
{% endif %}
{% if profile.twitter %}
  <div class="twitter-icon">
    <div class="icon mx-1" data-toggle="tooltip" title="Twitter Profile">
      <a href="{{ profile.twitter }}"><i class="fa-brands fa-twitter tw-icon fa-lg"></i></a>
    </div>
  </div>
{% endif %}
