---
layout: default
---
<div class="post">
  <header
    class="post-header text-center"
    style="background: linear-gradient(rgba(255,255,255,0.9), rgba(255,255,255,0.9)), url('/assets/img/AIRob.png'); background-size: cover; background-position: center; background-repeat: no-repeat; padding: 4rem 2rem;"
  >
    <h1 class="post-title" style="font-size: 6rem;">
      AI<img
        src="/assets/img/R_robot.png"
        alt=""
        style="height: 1.33em; vertical-align: 0em;"

      >ob Lab
    </h1>
    <p class="desc">
      <em>{{ page.subtitle }}</em>
    </p>
  </header>

  <article>
    <div class="clearfix">{{ content }}</div>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <br>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">News</a>
      </h2>
      {% include news.liquid limit=true %}
      <a href="{{ '/news/' | relative_url }}">More news</a>
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <br>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">Recent Publications</a>
      </h2>
      <div class="publications">
        {% bibliography --group_by none --offset 1 --max 5 %}
      </div>
      <a href="{{ '/publications/' | relative_url }}">Full list of publications</a>
    {% endif %}

    <h2>
      <br>
      Contact Information
    </h2>
    <p>
      <i class="fa-solid fa-map-marker-alt fa-fw"></i> <a href="https://roomfinder.sfu.ca/apps/sfuroomfinder_web/?q=TASC18005">TASC1 8005</a>, Simon
      Fraser University<br>
      <i class="fa-solid fa-location fa-fw"></i> 8888 University Drive, Buraby, BC, Canada V5A 1S6<br>
      <i class="fa-solid fa-envelope fa-fw"></i> hangma at sfu dot ca
    </p>

    {% assign profile_image_class = 'img-fluid z-depth-1 h-100 object-fit-contain' %}
    <div class="d-flex flex-row align-items-stretch" style="height: clamp(80px, 6vw, 100px);">
      <div class="d-flex h-100">
        {%
          include figure.liquid
          loading="eager"
          path='assets/img/sfuai_wide.png'
          class=profile_image_class
          alt=''
          cache_bust=true
        %}
      </div>
      <div class="d-flex h-100">
        {% include figure.liquid loading="eager" path='assets/img/logo_w_sfu.png' class=profile_image_class alt='' cache_bust=true %}
      </div>
    </div>

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
